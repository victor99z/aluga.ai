# Backend persistence ("pocketbase" or "sqlite")
DB_TYPE=pocketbase

# PocketBase configuration
POCKETBASE_URL=https://pb.victorbernardes.me
POCKETBASE_EMAIL=
POCKETBASE_PASSWORD=
POCKETBASE_TOKEN=
POCKETBASE_UPLOAD_IMAGES=true

# Cloudflare Tunnel token (Zero Trust -> Networks -> Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=

# SQLite fallback configuration (when DB_TYPE=sqlite)
DATABASE_URL=sqlite://./data/aluga.db

# Crawler settings
CRAWLER_MAX_PAGES=50
CRAWLER_DELAY_MS=2000
